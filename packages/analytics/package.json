{
	"name": "@merijnslegers/analytics",
	"version": "0.2.0",
	"description": "The visitor numbers of the software factory: reads Vercel Web Analytics on the server, turns it into totals, a series and top lists, and shows them in the admin with ready-made blocks.",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./rules": {
			"types": "./src/rules.d.ts",
			"default": "./src/rules.js"
		},
		"./server": {
			"types": "./src/server.d.ts",
			"default": "./src/server.js"
		},
		"./visitors": {
			"types": "./src/visitors.d.ts",
			"default": "./src/visitors.js"
		},
		"./ui": {
			"types": "./src/ui/index.d.ts",
			"svelte": "./src/ui/index.js",
			"default": "./src/ui/index.js"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"engines": {
		"node": ">=22.17"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Merijnslegers90/software-factory.git",
		"directory": "packages/analytics"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
