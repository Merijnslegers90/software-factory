{
	"name": "@merijnslegers/admin",
	"version": "0.5.0",
	"description": "The admin of the software factory: the login (Supabase Auth or HTTP Basic per person), the access rules and headers, content changes through a pull request with a form block, the admin building blocks as Svelte components, and image resizing in the browser.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"admin": "./bin/admin.js"
	},
	"exports": {
		"./rules": {
			"types": "./src/rules.d.ts",
			"default": "./src/rules.js"
		},
		"./server": {
			"types": "./src/server.d.ts",
			"default": "./src/server.js"
		},
		"./resize": {
			"types": "./src/resize.d.ts",
			"default": "./src/resize.js"
		},
		"./password": {
			"types": "./src/password.d.ts",
			"default": "./src/password.js"
		},
		"./github": {
			"types": "./src/github.d.ts",
			"default": "./src/github.js"
		},
		"./github-rules": {
			"types": "./src/github-rules.d.ts",
			"default": "./src/github-rules.js"
		},
		"./content-form": {
			"types": "./src/content-form.d.ts",
			"default": "./src/content-form.js"
		},
		"./content-form-server": {
			"types": "./src/content-form-server.d.ts",
			"default": "./src/content-form-server.js"
		},
		"./ui": {
			"types": "./src/ui/index.d.ts",
			"svelte": "./src/ui/index.js",
			"default": "./src/ui/index.js"
		},
		"./github/ui": {
			"types": "./src/ui/github.d.ts",
			"svelte": "./src/ui/github.js",
			"default": "./src/ui/github.js"
		},
		"./ui/text": {
			"types": "./src/ui/text.d.ts",
			"default": "./src/ui/text.js"
		}
	},
	"files": [
		"bin",
		"src",
		"README.md"
	],
	"engines": {
		"node": ">=22.17"
	},
	"peerDependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Merijnslegers90/software-factory.git",
		"directory": "packages/admin"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependenciesMeta": {
		"@supabase/ssr": {
			"optional": true
		},
		"@supabase/supabase-js": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
